# Development only: never commit configured secrets.
POSTGRES_DB=eternalia
POSTGRES_USER=eternalia
POSTGRES_PASSWORD=replace-in-local-dev
DATABASE_URL=postgres://eternalia:replace-in-local-dev@127.0.0.1:5432/eternalia
API_PORT=3001
NUXT_API_INTERNAL_URL=http://127.0.0.1:3001

# The single author MUST authenticate with this exact Discord user ID.
APP_ORIGIN=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_AUTHOR_USER_ID=

# If DATABASE_URL is absent, only the legacy read-only preview bridge is available.
# ALPHA_LIBRARY_FILE=/absolute/path/to/.local/preview-data.json
