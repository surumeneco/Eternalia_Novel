# Local-only development. Replace placeholders before starting Docker/Postgres.
POSTGRES_DB=eternalia
POSTGRES_USER=eternalia
POSTGRES_PASSWORD=replace-in-local-dev
DATABASE_URL=postgres://eternalia:replace-in-local-dev@127.0.0.1:5432/eternalia
API_PORT=3001
NUXT_API_INTERNAL_URL=http://127.0.0.1:3001

# Optional temporary legacy preview read-only bridge; never publish its admin endpoints.
# ALPHA_LIBRARY_FILE=/absolute/path/to/.local/preview-data.json

